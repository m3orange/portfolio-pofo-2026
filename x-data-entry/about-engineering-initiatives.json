// Creating the table and its structure




CREATE TABLE engineering_initiatives (
        id INT AUTO_INCREMENT PRIMARY KEY,
        title VARCHAR(255) NOT NULL,
        short_text TEXT,
        long_text TEXT,
        file_path VARCHAR(500) NOT NULL,
        caption TEXT,
        sort_order INT DEFAULT 0
);

